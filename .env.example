# Porta HTTP (padrão 3002) e HTTPS para o celular (padrão 3443, só sobe se .certs/ existir)
PORT=3002
PORT_HTTPS=3443

# Opcional: chave gratuita do pokemontcg.io (https://dev.pokemontcg.io) para limites maiores e menos 5xx
POKEMONTCG_API_KEY=

# Opcional: URL do Ollama (padrão http://localhost:11434) e modelo de visão
OLLAMA_URL=http://localhost:11434
VISION_MODEL=qwen2.5vl:7b
